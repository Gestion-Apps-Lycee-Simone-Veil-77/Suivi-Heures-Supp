# Copiez ce fichier en ".env" dans le dossier client/.
# Les variables Vite doivent commencer par VITE_ pour être accessibles au navigateur.

# Même Client ID OAuth que côté serveur (GOOGLE_OAUTH_CLIENT_ID dans le .env racine).
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# (Le bouton "Ouvrir le Google Sheet" de la page Admin est désormais dérivé
# automatiquement de SPREADSHEET_ID côté serveur — rien à configurer ici.)
